chain srcnat {
    # 1. 匹配目标端口
    meta l4proto { tcp, udp } th dport { 10085, 10086 } counter masquerade comment "RustDesk 端口"
    meta l4proto { tcp, udp } th dport { 34000 } counter masquerade comment "Kaadas 端口"
    meta l4proto { tcp, udp } th dport { 8887, 9101, 50443, 50921, 9443, 2000 } counter masquerade comment "移动看家端口"

    meta l4proto { tcp, udp } th dport { 5260, 5288, 5683, 19302, 8883, 5224, 8886, 7004, 8887, 5222} counter masquerade comment "疑似端口"
    meta l4proto { tcp, udp } th dport { 9090, 996, 500, 11010, 58888, 53317} counter masquerade comment "本地的一些服务端口"
    # 2. Kaadas & RustDesk 节点 IP
    meta l4proto { tcp, udp } ip daddr { 120.76.73.193, 123.158.252.160 } masquerade comment "Kaadas 服务器"
    meta l4proto { tcp, udp } ip daddr { 119.28.81.142 } masquerade comment "RustDesk 服务器"

    # 3. 移动摄像头/其他 IPv4 段
    meta l4proto { tcp, udp } ip daddr {
        36.133.203.0/24, 36.137.66.0/24, 36.137.109.0/24, 36.139.163.0/24,
        36.139.181.0/24, 36.139.182.0/24, 36.140.76.0/24, 36.140.77.0/24,
        36.140.240.0/24, 39.135.97.0/24, 39.136.113.0/24, 39.136.156.0/24,
        39.137.116.0/24, 39.156.138.0/24, 39.173.35.0/24, 39.173.116.0/24,
        39.185.58.0/24, 47.93.219.0/24, 59.82.113.0/24, 112.13.92.0/24,
        112.13.96.0/24, 112.13.168.0/24, 112.17.28.0/24, 111.1.57.0/24,
        119.3.230.0/24, 124.71.236.0/24, 183.230.40.0/24, 183.230.102.0/24,
        221.178.45.0/24, 111.0.47.0/24, 45.141.171.0/24
    } masquerade comment "移动摄像头及其他业务 IP 段"

    # 4. IPv6 目标地址段
    meta l4proto { tcp, udp } ip6 daddr {
        2409:8060:8ea:601::/64, 2409:8087:2801::/48, 2409:8087:2806::/48,
        2409:8087:5710:14::/64, 2409:8c28:e00::/64, 2409:8c28:202:1a::/64,
        2409:8c28:202:1b::/64, 2409:8c28:2808:5::/64, 2409:8c60:2500:28::/64,
        2409:8c85:420:6a::/64
    } masquerade comment "移动摄像头 IPv6 业务网段"

    # 5 匹配目标为 80, 443 的 TCP/UDP 流量，且经过 DNAT/TPROXY 转发的流量才做 masquerade
    meta l4proto { tcp, udp } th dport { 80, 443 } ip daddr != 192.168.0.0/16 masquerade
}
